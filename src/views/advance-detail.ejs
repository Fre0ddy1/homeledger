<section class="card mb16"><div class="card-head"><h2><%= item.person %>的代垫</h2><span class="chip"><%= item.deleted_at?'已撤销':item.remaining_cents?'待回收':'已收齐' %></span></div><div class="advance-summary"><div><p class="muted small">实际付款</p><b class="amount finance-total"><%= helpers.fmtAmount(item.amount_cents) %> <%= item.currency %></b></div><div><p class="muted small">自用消费</p><b class="amount"><%= helpers.fmtAmount(item.personal_cents) %></b></div><div><p class="muted small">代垫 / 待收</p><b class="amount"><%= helpers.fmtAmount(item.advance_cents) %> / <%= helpers.fmtAmount(item.remaining_cents) %></b></div></div><p class="small muted mt16">交易日期 <%= item.txn_date %><%= item.txn_time?' '+item.txn_time:'（未提供时刻）' %> · 录入 <%= item.created_at %></p><p class="help">自用部分计入消费；代垫转为应收，回款本金冲减应收；明确确认的凑整差额计入收入。两套报表不会重复计算。</p></section>
<% if(item.replaced_by){ %><section class="card mb16"><a class="btn" href="/advances/<%= item.replaced_by %>">查看更正后的代垫</a></section><% } %>
<% if(canWrite(ledger.role)&&!item.deleted_at){ %><div class="entry-actions mb16"><a class="btn btn-primary" href="/transactions/<%= item.primary_transaction_id %>/edit?back=<%= encodeURIComponent('/advances/'+item.id) %>">编辑</a></div><% } %>
<% if(images.length){ %><section class="card mb16"><h2>原付款附件</h2><div class="gallery"><% images.forEach(img=>{ %><a href="<%= img.url %>" target="_blank" rel="noopener"><img src="<%= img.url %>" alt="原付款账单截图" loading="lazy"></a><% }); %></div></section><% } %>
<div class="finance-detail">
  <div><section class="card"><h2>付款分项</h2><% item.transactions.forEach(t=>{ %><div class="finance-item"><div><b>#<%= t.id %> · <%= ({personal:'自用消费',advance:'代垫应收',original:'拆分前原记录'})[t.role]||t.role %></b><p class="small muted"><%= t.deleted_at?'已停用':'有效' %> · <%= t.note||'' %></p></div><b class="amount"><%= helpers.fmtAmount(t.amount_cents) %></b></div><% }); %></section></div>
  <aside>
    <%- include('partials/advance-recovery',{editing:false}) %>
    <% if(canWrite(ledger.role)&&!item.deleted_at){ %><form id="advance-recovery-form" method="post" action="/advances/<%= item.id %>/collect"></form><% } %>
    <% if(canWrite(ledger.role)&&!item.replaced_by){ %><section class="card"><h2>整体操作</h2><p class="help"><%= item.source_transaction_id?'撤销后恢复拆分前的完整支出。':'撤销后付款的全部分项不再计入余额与报表。' %>有有效回款时须先撤销回款。</p><form method="post" action="/advances/<%= item.id %>/<%= item.deleted_at?'restore':'reverse' %>" data-confirm="确认<%= item.deleted_at?'恢复':'整体撤销' %>代垫？"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn <%= item.deleted_at?'':'btn-danger' %>"><%= item.deleted_at?'恢复代垫':'整体撤销' %></button></form></section><% } %>
  </aside>
</div>
