<section class="card mb16"><div class="card-head"><h2><%= item.person %>的代垫</h2><span class="chip"><%= item.deleted_at?'已撤销':item.remaining_cents?'待回收':'已收齐' %></span></div><div class="advance-summary"><div><p class="muted small">实际付款</p><b class="amount finance-total"><%= helpers.fmtAmount(item.amount_cents) %> <%= item.currency %></b></div><div><p class="muted small">自用消费</p><b class="amount"><%= helpers.fmtAmount(item.personal_cents) %></b></div><div><p class="muted small">代垫 / 待收</p><b class="amount"><%= helpers.fmtAmount(item.advance_cents) %> / <%= helpers.fmtAmount(item.remaining_cents) %></b></div></div><p class="small muted mt16">交易日期 <%= item.txn_date %><%= item.txn_time?' '+item.txn_time:'（未提供时刻）' %> · 录入 <%= item.created_at %></p><p class="help">自用部分计入消费；代垫转为应收，回款只增加资金并冲减应收。两套报表不会重复计算。</p></section>
<% if(item.replaced_by){ %><section class="card mb16"><a class="btn" href="/advances/<%= item.replaced_by %>">查看更正后的代垫</a></section><% } %>
<% if(images.length){ %><section class="card mb16"><h2>原付款附件</h2><div class="gallery"><% images.forEach(img=>{ %><a href="<%= img.url %>" target="_blank" rel="noopener"><img src="<%= img.url %>" alt="原付款账单截图" loading="lazy"></a><% }); %></div></section><% } %>
<div class="finance-detail"><div><section class="card"><h2>付款分项</h2><% item.transactions.forEach(t=>{ %><div class="finance-item"><div><b>#<%= t.id %> · <%= ({personal:'自用消费',advance:'代垫应收',original:'拆分前原记录'})[t.role]||t.role %></b><p class="small muted"><%= t.deleted_at?'已停用':'有效' %> · <%= t.note||'' %></p></div><b class="amount"><%= helpers.fmtAmount(t.amount_cents) %></b></div><% }); %></section><section class="card"><h2>回收记录</h2><% if(!item.collections.length){ %><p class="muted mt16">还没有回款</p><% } %><% item.collections.forEach(c=>{ %><div class="finance-item"><div><b><%= helpers.fmtAmount(c.amount_cents) %> <%= item.currency %></b><p class="small muted"><%= c.txn_date %><%= c.txn_time?' '+c.txn_time:'' %> · <%= c.deleted_at?'已撤销':'已回收' %></p></div><% if(canWrite(ledger.role)&&!item.deleted_at){ %><form method="post" action="/advances/<%= item.id %>/collections/<%= c.id %>/<%= c.deleted_at?'restore':'reverse' %>" data-confirm="确认<%= c.deleted_at?'恢复':'撤销' %>这笔回款？"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm <%= c.deleted_at?'':'btn-danger' %>"><%= c.deleted_at?'恢复':'撤销' %>回款</button></form><% } %></div><% }); %></section></div>
<aside><% if(canWrite(ledger.role)){ %><% if(!item.deleted_at&&item.remaining_cents){ %><section class="card"><h2>登记回款</h2><p class="help">可分多次收回，金额不得超过待收余额。</p><form method="post" action="/advances/<%= item.id %>/collect" class="finance-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= draft?.operation_key||operationKey %>"><div class="field"><label>本次收回金额</label><input type="text" inputmode="decimal" name="amount" value="<%= draft?.amount??(item.remaining_cents/100).toFixed(2) %>" required></div><div class="field"><label>收款账户</label><select name="account_id" required><option value="">请选择</option><% form.accounts.filter(a=>['cash','debit','virtual','prepaid'].includes(a.type)&&a.currency===item.currency).forEach(a=>{ %><option value="<%= a.id %>" <%= Number(draft?.account_id)===a.id?'selected':'' %>><%= a.name %> · <%= a.type_label %></option><% }); %></select></div><div class="finance-fields"><div class="field"><label>收款日期</label><input type="date" name="date" value="<%= draft?.date??today %>" required></div><div class="field"><label>收款时刻（可选）</label><input type="time" name="time" step="1" value="<%= draft?.time??'' %>"></div></div><button class="btn btn-primary">确认收回</button></form></section><% } %><% if(!item.deleted_at&&!item.received_cents){ %><section class="card"><details><summary>更正代垫</summary><p class="help">整体替换付款分项，不重复扣款。已有来源的付款总额保持不变；已有回款请先撤销。</p><form method="post" action="/advances/<%= item.id %>/amend" class="finance-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= amendKey %>"><div class="field"><label>代垫对象</label><input name="person" value="<%= item.person %>" maxlength="60" required></div><div class="finance-fields"><div class="field"><label>付款总额</label><input name="amount" inputmode="decimal" value="<%= (item.amount_cents/100).toFixed(2) %>" <%= item.source_transaction_id?'readonly':'' %> required></div><div class="field"><label>其中自用金额</label><input name="personal" inputmode="decimal" value="<%= (item.personal_cents/100).toFixed(2) %>" required></div></div><button class="btn">确认整体更正</button></form></details></section><% } %><% if(!item.replaced_by){ %><section class="card"><h2>整体操作</h2><p class="help"><%= item.source_transaction_id?'撤销后恢复拆分前的完整支出。':'撤销后付款的全部分项不再计入余额与报表。' %>有有效回款时须先撤销回款。</p><form method="post" action="/advances/<%= item.id %>/<%= item.deleted_at?'restore':'reverse' %>" data-confirm="确认<%= item.deleted_at?'恢复':'整体撤销' %>代垫？"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn <%= item.deleted_at?'':'btn-danger' %>"><%= item.deleted_at?'恢复代垫':'整体撤销' %></button></form></section><% } %><% } %></aside></div>
