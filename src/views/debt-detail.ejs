
<section class="card mt16"><div class="card-head"><h2><%= debt.counterparty %> · <%= debt.direction==='receivable'?'应收':'应还' %></h2><span class="chip"><%= debt.deleted_at?'已归档':debt.status==='closed'?'已结清':'待结清' %> · #<%= debt.id %></span></div>
<div class="stats stats-3"><div><span class="muted">本金</span><p class="amount"><%= helpers.money(debt.principal_cents) %></p></div><div><span class="muted">剩余</span><p class="amount"><%= helpers.money(debt.balance_cents) %></p></div><div><span class="muted">到期</span><p><%= debt.due_date||'未设置' %></p></div></div>
<p class="help">本金与收还不计收入或支出。已有流水通过下方关联，不会再次移动资金。</p></section>
<div class="grid grid-main"><section class="card"><div class="card-head"><h2>关联流水</h2></div>
<% if(!debt.transactions.length){ %><div class="empty">期初登记条目，尚无已关联流水。</div><% } %>
<% debt.transactions.forEach(function(t){ %><div class="row between mb12"><div><a href="/transactions/<%= t.id %>/edit"><%= t.txn_date %> · <%= ({lend:'借出',borrow:'借入',repay_receive:'收回借款',repay_pay:'偿还借款'})[t.type] || t.type %></a><p class="tiny muted"><%= t.note||'' %> <%= t.deleted_at?'（已删除，已撤销核销）':'' %></p></div><b class="amount"><%= helpers.money(t.amount_cents) %></b></div><% }); %></section>
<div><% if(canWrite(ledger.role)){ %><section class="card">
<% if(debt.deleted_at){ %><form method="post" action="/debts/<%= debt.id %>/restore"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary">恢复条目</button></form><% }else{ %>
<h2><%= debt.direction==='receivable'?'收款核销':'还款核销' %></h2><form method="post" action="/debts/<%= debt.id %>/settle" class="mt16"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= operationKey %>"><div class="field"><label>实际金额</label><input type="text" name="amount" inputmode="decimal" value="<%= (debt.balance_cents/100).toFixed(2) %>" required></div><div class="field"><label>资金账户</label><select name="account_id" required><option value="">请选择</option><% form.accounts.filter(a=>a.transaction_types.split(',').includes('lend')).forEach(function(a){ %><option value="<%= a.id %>"><%= a.name %></option><% }); %></select></div><div class="field"><label>日期</label><input type="date" name="date" value="<%= today %>" required></div><button class="btn btn-primary" <%= !debt.balance_cents?'disabled':'' %>>确认实际收还</button></form>
<div class="divider"></div><h3>关联已有流水</h3><form method="post" action="/debts/<%= debt.id %>/link" class="mt12"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label>待关联的借钱流水</label><select name="transaction_id" required><option value="">请选择，金额会核对</option><% unlinked.forEach(function(t){ %><option value="<%= t.id %>">#<%= t.id %> · <%= t.txn_date %> · <%= t.merchant||t.note||t.type %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div><label class="check mb12"><input type="checkbox" name="opening_included" value="1">这笔已包含在登记的期初余额中，仅补充历史关联</label><button class="btn">确认关联，不生成新流水</button></form>
<div class="divider"></div><form method="post" action="/debts/<%= debt.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label>对方姓名</label><input type="text" name="counterparty" value="<%= debt.counterparty %>" required></div><div class="field"><label>到期日</label><input type="date" name="due_date" value="<%= debt.due_date||'' %>"></div><div class="field"><label>备注</label><input type="text" name="note" value="<%= debt.note||'' %>"></div><div class="field"><label>到期提醒</label><select name="remind_enabled"><option value="1" <%= debt.remind_enabled?'selected':'' %>>开启</option><option value="0" <%= !debt.remind_enabled?'selected':'' %>>关闭</option></select></div><button class="btn">保存条目信息</button></form>
<% } %></section><% } %></div></div>
