<section class="card mt16"><div class="card-head"><h2><%= statement.closing_date %> 账单</h2><span class="chip"><%= statement.dirty?'有差异，待重新核对':statement.confirmed_at?'银行账单已确认':'自动账单' %></span></div><p class="small muted">账期 <%= statement.period_start %> 至 <%= statement.closing_date %> · 还款日 <%= statement.due_date %></p><div class="stats stats-3"><div><span class="muted">账单总额</span><p class="amount"><%= helpers.money(statement.total_cents) %></p></div><div><span class="muted">已还款</span><p class="amount"><%= helpers.money(statement.paid_cents) %></p></div><div><span class="muted">待还</span><p class="amount"><%= helpers.money(statement.remaining_cents) %></p></div></div><% if(statement.dirty){ %><div class="notice warn mt16">本地流水已变化，原确认金额与快照已保留。当前归集金额 <%= helpers.money(statement.computed_cents) %>，自动还款仍以已校正的银行金额为准；需要修改该金额时可展开银行账单校正。</div><% } %></section>
<% if(statement.credit_applied_cents){ %><div class="notice info mb16">退款余额已自动抵扣 <%= helpers.money(statement.credit_applied_cents) %>，无需再次还款。</div><% } %><div class="finance-detail"><div><section class="card"><h2><%= statement.confirmed_at?'确认时的流水快照':'账单流水' %></h2><% if(!statement.items.length){ %><div class="empty">本期尚无消费。</div><% } %><% statement.items.forEach(i=>{ %><div class="finance-item"><div><b><%= i.label %></b><p class="tiny muted">流水 #<%= i.transaction_id %> · <%= i.posted_date||i.txn_date %></p></div><b class="amount"><%= helpers.money(i.amount_cents) %></b></div><% }); %>
<% if(statement.dirty){ %><details class="mt16"><summary>查看当前重新归集结果</summary><% statement.expected_items.forEach(i=>{ %><p class="row between"><span>#<%= i.transaction_id %> · <%= i.label %></span><b><%= helpers.money(i.amount_cents) %></b></p><% }); %></details><% } %></section>
<section class="card"><h2>关联还款</h2><% statement.allocations.forEach(a=>{ %><a class="finance-item" href="/finance/payments/<%= a.payment_id %>"><span><%= a.txn_date %> · #<%= a.payment_id %> <%= a.deleted_at?'（已撤销）':'' %></span><b><%= helpers.money(a.principal_cents) %></b></a><% }); %></section><section class="card"><details><summary>账单修订记录（<%= revisions.length %>）</summary><% revisions.forEach(r=>{ %><p>版本 <%= r.revision %> · <%= helpers.money(r.amount_cents) %> · <%= r.created_at %><br><span class="small muted"><%= r.note||'银行账单核对' %></span></p><% }); %></details></section></div>
<aside><% if(canWrite(ledger.role)){ %><section class="card"><details><summary>可选：校正银行账单</summary><form class="finance-form" method="post" action="/finance/statements/<%= statement.id %>/confirm"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm" value="1"><div class="field"><label>银行实际账单总额（元）</label><input type="text" name="confirmed_amount" inputmode="decimal" value="<%= (statement.total_cents/100).toFixed(2) %>" required></div><div class="field"><label>校正说明</label><input type="text" name="note" maxlength="300" value="<%= statement.note||'' %>"></div><label class="check mb12"><input type="checkbox" name="release_credit" value="1">金额调低时，多余已核销金额转为未分配预还款</label><button class="btn btn-primary">确认银行账单并保留版本</button></form><% if(statement.confirmed_at){ %><form method="post" action="/finance/statements/<%= statement.id %>/unconfirm" class="mt16"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm" value="1"><label class="check mb12"><input type="checkbox" name="release_credit" value="1">如本地金额较低，释放超额核销</label><button class="btn">撤销确认，重新整理流水</button></form><% } %></details><a class="btn mt16" href="/finance/cards/<%= statement.account_id %>">去还款</a></section>
<section class="card"><details><summary>入账日校正与退款关联</summary><p class="help">请先撤销相关账单确认，再选择流水校正。退款金额按原流水记录，本操作只补充关联。</p><form class="finance-form" method="post" action="/finance/transactions/posting" data-finance-txn-action="posting"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label>流水</label><select name="transaction_id" required><option value="">请选择</option><% sources.filter(t=>t.account_id===statement.account_id).forEach(t=>{ %><option value="<%= t.id %>">#<%= t.id %> · <%= t.note||t.type %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div><div class="field"><label>银行入账日</label><input type="date" name="posted_date" required></div><div class="field"><label>退款对应的原消费（可选）</label><select name="refund_of_id"><option value="">不关联／非退款</option><% sources.filter(t=>t.account_id===statement.account_id&&t.type==='expense').forEach(t=>{ %><option value="<%= t.id %>">#<%= t.id %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div><button class="btn">保存校正</button></form></details></section>
<section class="card"><details><summary>设置消费分期</summary><p class="help">已确认的消费请先撤销确认。分期不再次记支出。</p><form class="finance-form" method="post" action="/finance/transactions/installment"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label>原消费</label><select name="transaction_id" required><option value="">请选择</option><% sources.filter(t=>t.account_id===statement.account_id&&t.type==='expense').forEach(t=>{ %><option value="<%= t.id %>">#<%= t.id %> · <%= t.note||t.txn_date %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div><div class="finance-fields"><div class="field"><label>期数</label><input type="number" name="term_n" min="1" max="120" required></div><div class="field"><label>首期出账日</label><input type="date" name="first_closing" value="<%= statement.closing_date %>" required></div></div><div class="finance-fields"><div class="field"><label>预计总利息（元）</label><input type="text" name="interest" inputmode="decimal" value="0"></div><div class="field"><label>预计总手续费（元）</label><input type="text" name="fee" inputmode="decimal" value="0"></div></div><button class="btn">创建分期计划</button></form></details></section>
<section class="card"><details><summary>记录银行实际利息与费用</summary><form class="finance-form mt16" method="post" action="/finance/statements/<%= statement.id %>/charges"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= operationKey %>"><div class="finance-fields"><div class="field"><label>实际利息（元）</label><input type="text" name="interest" inputmode="decimal" value="0"></div><div class="field"><label>实际手续费（元）</label><input type="text" name="fee" inputmode="decimal" value="0"></div></div><div class="field"><label>费用日期</label><input type="date" name="date" value="<%= statement.closing_date %>" required></div><label class="check mb12"><input type="checkbox" name="confirm_revision" value="1">如账单已确认，费用已包含在银行总额中，确认补记并修订快照</label><button class="btn">记录实际费用</button></form></details></section><% } %></aside></div>
