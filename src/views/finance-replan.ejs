<section class="card mt16"><h2>预览后续计划</h2><p class="help">剩余本金 <%= helpers.money(preview.remaining_principal_cents) %>。已还记录保留，新计划仅替换未还部分。</p><div class="table-wrap"><table class="table"><thead><tr><th>日期</th><th>本金</th><th>利息</th><th>手续费</th></tr></thead><tbody><% preview.schedule.forEach(i=>{ %><tr><td><%= i.due_date %></td><td><%= helpers.money(i.principal_cents) %></td><td><%= helpers.money(i.interest_cents) %></td><td><%= helpers.money(i.fee_cents) %></td></tr><% }); %></tbody></table></div><form method="post" action="/finance/loans/<%= loan.id %>/plan" class="mt16"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm" value="1"><input type="hidden" name="basis" value="<%= preview.basis %>"><% ['term_n','annual_rate','method','start_date','due_day','schedule'].forEach(k=>{if(params[k]!==undefined){ %><input type="hidden" name="<%= k %>" value="<%= typeof params[k]==='object'?JSON.stringify(params[k]):params[k] %>"><% }}); %><button class="btn btn-primary">确认应用此计划</button></form></section>
