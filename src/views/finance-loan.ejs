<section class="card mt16"><div class="card-head"><h2><%= loan.name %></h2><span class="chip"><%= loan.deleted_at?'已归档':loan.remaining_principal_cents?'还款中':'本金已结清' %></span></div><div class="stats stats-3"><div><span class="muted">原始本金</span><p class="amount"><%= helpers.money(loan.original_principal_cents) %></p></div><div><span class="muted">剩余本金</span><p class="amount"><%= helpers.money(loan.remaining_principal_cents) %></p></div><div><span class="muted">金融机构</span><p><%= loan.institution||'未填写' %></p></div></div></section>
<div class="finance-detail"><div><section class="card"><div class="card-head"><h2>还款计划</h2><span class="tiny muted">预计与实付分别保留</span></div><div class="table-wrap"><table class="table"><thead><tr><th>到期日</th><th>预计本金</th><th>预计利息／费用</th><th>已核销</th><th>待还</th></tr></thead><tbody><% loan.installments.forEach(i=>{ %><tr><td><%= i.due_date %></td><td><%= helpers.money(i.principal_cents) %></td><td><%= helpers.money(i.interest_cents+i.fee_cents) %></td><td><%= helpers.money(i.paid_principal+i.paid_interest+i.paid_fee) %></td><td><%= helpers.money(i.remaining_principal+i.remaining_interest+i.remaining_fee) %></td></tr><% }); %></tbody></table></div></section>
<section class="card"><h2>实际付款记录</h2><% if(!loan.payments.length){ %><div class="empty">暂无付款，登记计划不会自动扣款。</div><% } %><% loan.payments.forEach(p=>{ %><a class="finance-item" href="/finance/payments/<%= p.id %>"><div><b><%= p.txn_date %></b><p class="tiny muted">#<%= p.id %> · <%= p.deleted_at?'已撤销':'已核销' %></p></div><b class="amount"><%= helpers.money(p.amount_cents) %></b></a><% }); %></section></div>
<aside><% if(canWrite(ledger.role)){ %><section class="card"><% if(loan.deleted_at){ %><h2>恢复合同</h2><p class="help">归档保留账户及历史付款。</p><form method="post" action="/finance/loans/<%= loan.id %>/restore"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn">恢复合同</button></form><% }else{ %><h2>记录实际还款</h2><%- include('partials/finance-payment-form',{kind:'loan',targetId:loan.id}) %><% } %></section>
<% if(!loan.deleted_at){ %><section class="card"><details><summary>调整后续还款计划</summary><form class="finance-form mt16" method="post" action="/finance/loans/<%= loan.id %>/plan/preview"><input type="hidden" name="_csrf" value="<%= csrf %>"><%- include('partials/finance-plan-fields',{params:{...loan,start_date:today}}) %><button class="btn">预览新计划</button></form></details></section>
<section class="card"><details><summary>合同信息与提醒</summary><form class="finance-form mt16" method="post" action="/finance/loans/<%= loan.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field"><label>名称</label><input type="text" name="name" value="<%= loan.name %>" required></div><div class="field"><label>机构</label><input type="text" name="institution" value="<%= loan.institution||'' %>"></div><div class="field"><label>到期提醒</label><select name="remind_enabled"><option value="1" <%= loan.remind_enabled?'selected':'' %>>开启</option><option value="0" <%= !loan.remind_enabled?'selected':'' %>>关闭</option></select></div><button class="btn">保存</button></form><form class="mt16" method="post" action="/finance/loans/<%= loan.id %>/delete" data-confirm="归档此合同？账户、流水与历史付款会保留。"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger">归档合同</button></form></details></section><% } %><% } %></aside></div>
