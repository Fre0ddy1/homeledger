<div class="row wrap mb16"><a class="btn btn-sm btn-primary" href="/reports?basis=cashflow&preset=<%= range.preset %>&month=<%= range.month||'' %>&from=<%= range.start %>&to=<%= range.end %>">资金流</a><a class="btn btn-sm" href="/reports?basis=consumption&preset=<%= range.preset %>&month=<%= range.month||'' %>&from=<%= range.start %>&to=<%= range.end %>">消费收支</a><a class="btn btn-sm" href="/annual">年度消费账单</a><span class="small muted">实际资金账户变化；自有资金账户互转与余额调整不计现金流</span></div>
<section class="card"><div class="cashflow-filters"><div class="row wrap"><% [['month','本月'],['quarter','本季度'],['year','本年'],['all','全部']].forEach(([key,label])=>{ %><a class="btn btn-sm <%= range.preset===key?'btn-primary':'' %>" href="/reports?basis=cashflow&preset=<%= key %>"><%= label %></a><% }); %></div><form class="cashflow-range" method="get"><input type="hidden" name="basis" value="cashflow"><input type="hidden" name="preset" value="custom"><input type="date" name="from" value="<%= range.start %>" aria-label="起始日期"><input type="date" name="to" value="<%= range.end %>" aria-label="结束日期"><button class="btn btn-sm">查看区间</button></form></div></section>
<div class="grid grid-3 mb16"><% [['资金流出',sum.outflow,'expense'],['资金流入',sum.inflow,'income'],['可用资金净变化',sum.net,'']].forEach(([label,value,cls])=>{ %><div class="stat"><div class="label"><%= label %></div><div class="value amount <%= cls %>"><%= helpers.money(value) %></div><div class="delta"><%= range.label %></div></div><% }); %></div>
<section class="card"><div class="card-head"><h2>资金流趋势</h2><span class="small muted">近12个月</span></div><div class="chart-box"><%- charts.barChart({labels:trend.map(t=>helpers.monthShort(t.month)),series:[{name:'流出',color:'#d83b42',data:trend.map(t=>t.expense/100)},{name:'流入',color:'#248544',data:trend.map(t=>t.income/100)}],height:280,width:960}) %></div></section>
<div class="grid grid-2"><% [['资金流出构成',outflow,'expense'],['资金流入构成',inflow,'income']].forEach(([title,groups,direction])=>{ %><section class="card"><h2><%= title %></h2><% if(!groups.length){ %><div class="empty">此区间暂无记录</div><% } %><% groups.forEach(g=>{ %><div class="finance-item"><div><b><%= g.name %></b><p class="small muted"><%= g.count %> 笔资金流水</p></div><div class="right"><b class="amount"><%= helpers.money(g.total) %></b><p><a class="btn btn-sm" href="/reports?basis=cashflow&preset=custom&from=<%= range.start %>&to=<%= range.end %>&kind=<%= direction %>&top=<%= encodeURIComponent(g.name) %>">查看明细</a></p></div></div><% }); %></section><% }); %></div>
<% if(entries){ %><section class="card"><h2><%= top %> · 实际资金流水</h2><%- include('partials/txn-list',{groups:groupCashDates(entries.rows),bulk:false}) %><div class="row wrap mt16"><% for(let p=Math.max(1,entries.page-2);p<=Math.min(entries.pages,entries.page+2);p++){ %><a class="btn btn-sm <%= p===entries.page?'btn-primary':'' %>" href="/reports?basis=cashflow&preset=custom&from=<%= range.start %>&to=<%= range.end %>&kind=<%= kind %>&top=<%= encodeURIComponent(top) %>&page=<%= p %>"><%= p %></a><% } %></div></section><% } %>
<p class="help">资金账户包括现金、储蓄卡、支付账户和预付卡。还款、借出和投资转入会减少可用资金；信用卡消费在消费口径记录，实际还款在资金流口径记录。预算和消费分析使用消费收支口径。</p>
