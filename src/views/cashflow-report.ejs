<%- include('partials/report-toolbar') %>
<div class="grid grid-4 mb16 report-metrics">
<% [['资金流出',sum.outflow,'expense'],['资金流入',sum.inflow,'income'],['可用资金净变化',sum.net,''],['笔均流出',analysis.avg_outflow,'expense']].forEach(([label,value,cls])=>{ %><div class="stat"><div class="label"><%= label %></div><div class="value amount <%= cls %>"><%= value===null?'—':helpers.money(value) %></div><div class="delta"><%= label==='笔均流出'?analysis.outflow_count+' 笔实际流出':range.label %></div></div><% }); %>
</div>
<div class="report-workspace">
<div class="report-column">
<% [['资金流出用途',outflow,'expense',sum.outflow],['资金流入来源',inflow,'income',sum.inflow]].forEach(([title,groups,direction,total])=>{ %>
<section class="card"><div class="card-head"><h2><%= title %></h2><span class="small muted">金额 · 占比 · 笔数</span></div>
<% if(!groups.length){ %><div class="empty">此区间暂无记录</div><% } %>
<% groups.forEach(g=>{ %><div class="flow-group"><div class="flow-group-head"><b><%= g.name %></b><b class="amount"><%= helpers.money(g.total) %></b></div><%- charts.progressBar(g.total,total,{height:6,color:g.color}) %><div class="flow-group-foot"><span class="small muted"><%= total>0?(g.total/total*100).toFixed(1):'—' %>% · <%= g.count %> 笔</span><a class="btn btn-sm" href="/reports?basis=cashflow&preset=custom&from=<%= range.start %>&to=<%= range.end %>&kind=<%= direction %>&top=<%= encodeURIComponent(g.name) %>">查看明细</a></div></div><% }); %>
</section><% }); %>
<section class="card"><div class="card-head"><h2>资金流出对比</h2><span class="small muted"><%= analysis.change_pct===null?'无可比基数':(analysis.change_pct>=0?'+':'')+analysis.change_pct.toFixed(1)+'%' %></span></div>
<% if(!analysis.previous){ %><p class="help">所选区间尚未开始，暂无前期对比。</p><% }else{ %>
<div class="flow-comparison"><div><span class="small muted">本期可比流出</span><p class="amount"><%= helpers.money(analysis.current_comparable.outflow) %></p><span class="small muted"><%= range.start %> — <%= analysis.effective_to %></span></div><div><span class="small muted">前期流出</span><p class="amount"><%= helpers.money(analysis.previous.outflow) %></p><span class="small muted"><%= analysis.compare_from %> — <%= analysis.compare_to %></span></div></div><% } %>
<div class="divider"></div><div class="flow-comparison"><div><span class="small muted">日均流出</span><p class="amount"><%= analysis.avg_daily_outflow===null?'—':helpers.money(analysis.avg_daily_outflow) %></p><span class="small muted"><%= analysis.elapsed_days %> 个自然日<%= analysis.effective_to?' · 截至 '+analysis.effective_to:'' %></span></div><div><span class="small muted">最大流出日</span><p class="amount"><%= analysis.max_day?helpers.money(analysis.max_day.expense):'—' %></p><span class="small muted"><%= analysis.max_day?.date||'暂无记录' %></span></div></div>
</section>
<% if(entries){ %><section class="card"><h2><%= top %> · 实际资金流水</h2><%- include('partials/txn-list',{groups:groupCashDates(entries.rows),bulk:false}) %><div class="row wrap mt16"><% for(let p=Math.max(1,entries.page-2);p<=Math.min(entries.pages,entries.page+2);p++){ %><a class="btn btn-sm <%= p===entries.page?'btn-primary':'' %>" href="/reports?basis=cashflow&preset=custom&from=<%= range.start %>&to=<%= range.end %>&kind=<%= kind %>&top=<%= encodeURIComponent(top) %>&page=<%= p %>"><%= p %></a><% } %></div></section><% } %>
</div>
<aside class="report-column">
<section class="card"><div class="card-head"><h2>期间资金流趋势</h2><span class="small muted"><%= analysis.chart_unit==='month'?'按月汇总':'每日实际流入与流出' %></span></div><div class="chart-box"><%- charts.barChart({labels:analysis.chart.map(d=>d.date.slice(5)),series:[{name:'流出',color:'#d83b42',data:analysis.chart.map(d=>d.expense/100)},{name:'流入',color:'#248544',data:analysis.chart.map(d=>d.income/100)}],height:240,width:720}) %></div></section>
<section class="card"><div class="card-head"><h2>流出构成</h2></div><% if(!outflow.length){ %><div class="empty">暂无资金流出</div><% }else{ %><div class="flow-donut"><%- charts.donutChart(outflow.map(g=>({name:g.name,value:g.total/100,color:g.color}))) %><div class="flow-legend"><% outflow.forEach(g=>{ %><div class="legend-row"><span><i style="background:<%= g.color %>"></i><%= g.name %></span><b class="amount"><%= (g.total/sum.outflow*100).toFixed(1) %>%</b></div><% }); %></div></div><% } %></section>
<section class="card"><div class="card-head"><h2>近12个月资金流</h2><span class="small muted">截至 <%= trend.at(-1).month %></span></div><div class="chart-box"><%- charts.barChart({labels:trend.map(t=>helpers.monthShort(t.month)),series:[{name:'流出',color:'#d83b42',data:trend.map(t=>t.expense/100)},{name:'流入',color:'#248544',data:trend.map(t=>t.income/100)}],height:240,width:720}) %></div></section>
<section class="card"><div class="card-head"><h2>同期消费参考</h2><a class="btn btn-sm" href="/reports?basis=consumption&preset=custom&from=<%= range.start %>&to=<%= range.end %>">消费报表</a></div><div class="flow-comparison"><div><span class="small muted">消费支出</span><p class="amount expense"><%= helpers.money(consumption.expense) %></p></div><div><span class="small muted">消费口径收入</span><p class="amount income"><%= helpers.money(consumption.income) %></p></div></div><p class="help">刷卡消费在消费口径记录，实际还款在资金流中记录。两组数据不相加，还款本金不重复计消费。</p></section>
</aside>
</div>
<p class="help">资金账户包括现金、储蓄卡、支付账户和预付卡。还款、借出和投资转入减少可用资金；自有资金账户互转抵销，余额调整与待确认记录不计实际资金流。</p>
