<% var writable=ledger&&canWrite(ledger.role); %>
<section class="overview-heading">
  <div><div class="eyebrow">你的生活，心中有数</div><h2>每一份积累，都看得见。</h2><p class="muted">资金进出与消费收支，同月对照，各自独立统计。</p></div>
  <form method="get" class="overview-month"><label for="overview-month">当前月份</label><input id="overview-month" type="month" name="month" value="<%= month %>" aria-label="查看月份"><button class="btn btn-sm" type="submit">查看</button></form>
</section>
<%- include('partials/overview-pair') %>
<div class="overview-assets small"><span>当前净资产 <b class="amount"><%= helpers.money(overview.net) %></b></span><span class="muted">资产 <%= helpers.money(overview.assets) %> · 负债 <%= helpers.money(overview.liabilities) %></span><a class="btn btn-sm" href="/accounts">管理账户</a></div>
<div class="dashboard-grid">
  <section class="card dashboard-trend" data-dashboard-column="main"><div class="card-head"><div class="spacer"><div class="eyebrow">CASH FLOW</div><h2>资金流趋势</h2></div><span class="muted small">近 6 个月</span><a class="btn btn-sm btn-ghost" href="/reports?basis=cashflow">详细报表 →</a></div><div class="chart-box"><%- charts.barChart({ labels:trend.map(function(t){return helpers.monthShort(t.month);}), series:[{name:'流出',color:'#d83b42',data:trend.map(function(t){return t.expense/100;})},{name:'流入',color:'#248544',data:trend.map(function(t){return t.income/100;})}], height:260, width:480 }) %></div></section>
  <section class="card dashboard-today" data-dashboard-column="plans"><div class="card-head"><div class="spacer"><div class="eyebrow">TODAY</div><h2>今日速览</h2></div><span class="muted small"><%= helpers.relDate(today) %></span></div><div class="today-total amount expense"><span class="currency-symbol">¥</span><%= helpers.fmtAmount(todaySummary.expense) %></div><p class="muted small">今日资金流出 · <%= todayList.length %> 笔记录</p><p class="small muted">今日消费支出 <span class="amount"><%= helpers.money(todayConsumption.expense) %></span></p>
    <% if(writable) { %><div class="today-actions"><a class="btn btn-primary" href="/transactions/new"><svg class="icon"><use href="#i-plus"></use></svg>记一笔</a><a class="btn" href="/ai"><svg class="icon"><use href="#i-bot"></use></svg>AI 记账</a></div><% } else { %><a class="btn mt16" href="/transactions">查看明细 →</a><% } %>
    <% if(!aiReady && writable) { %><p class="tiny muted mt16">AI 尚未配置，当前使用本地规则。<a href="/settings#ai">去配置 →</a></p><% } %>
  </section>
  <section class="card dashboard-recent" data-dashboard-column="main"><div class="card-head"><div class="spacer"><div class="eyebrow">ACTIVITY</div><h2>最近记录</h2></div><a class="btn btn-sm btn-ghost" href="/transactions">全部记录 →</a></div><%- include('partials/txn-list', {groups:[{date:recent[0]?recent[0].txn_date:'1970-01-01',items:recent,income:0,expense:0}].filter(function(g){return g.items.length;}),bulk:false}) %></section>
  <section class="card" data-dashboard-column="main"><div class="card-head"><h2>消费收支趋势</h2><a class="btn btn-sm" href="/reports?basis=consumption">查看报表</a></div><div class="chart-box"><%- charts.barChart({labels:consumptionTrend.map(t=>helpers.monthShort(t.month)),series:[{name:'消费支出',color:'#d83b42',data:consumptionTrend.map(t=>t.expense/100)},{name:'收入',color:'#248544',data:consumptionTrend.map(t=>t.income/100)}],height:220,width:480}) %></div></section>
  <%- include('partials/dashboard-composition', {kind:'expense', title:'消费支出构成', items:cats, total:cur.expense}) %>
  <%- include('partials/dashboard-composition', {kind:'income', title:'收入构成', items:incomeCats, total:cur.income}) %>
  <section class="card dashboard-goals" data-dashboard-column="plans" id="savings-goals"><div class="card-head"><div class="spacer"><div class="eyebrow">LITTLE BY LITTLE</div><h2>储蓄目标完成率</h2></div><a class="btn btn-sm btn-ghost" href="/goals">查看 →</a></div>
    <% if(!goals.length) { %><div class="empty"><span class="empty-symbol"><svg class="icon lg"><use href="#i-piggy-bank"></use></svg></span><b>为下一件期待的事存钱</b><p class="small mt8">从一场旅行，或一份安心开始。</p><% if(writable) { %><a class="btn btn-sm mt16" href="/goals">创建储蓄目标</a><% } %></div><% } %>
    <% goals.forEach(function(g){var target=Number(g.target_cents);var saved=Number(g.saved_cents);var pct=target>0?Math.max(0,Math.min(100,saved/target*100)):0; %>
    <div class="goal-summary"><div class="row between"><span class="bold goal-name"><%= g.icon %> <%= g.name %></span><span class="goal-percent amount"><%= pct.toFixed(1) %>%</span></div><div class="mt12"><%- charts.progressBar(Math.max(0,Math.min(saved,target)),Math.max(0,target),{color:'#248544',height:7}) %></div><div class="goal-amounts small mt8"><span><%= helpers.fmtAmount(saved) %> <span class="muted">/ <%= helpers.fmtAmount(target) %></span></span><span class="muted">还差 <%= helpers.fmtAmount(Math.max(0,target-saved)) %></span></div></div>
    <% }); %>
  </section>
    <% if (pendingReimburse.count) { %>
    <div class="card" data-dashboard-column="plans">
      <div class="card-head"><h2>待报销</h2></div>
      <div class="row between">
        <span><%= pendingReimburse.count %> 笔待报销</span>
        <span class="amount"><%= helpers.money(pendingReimburse.sum) %></span>
      </div>
      <a class="btn btn-sm btn-block mt12" href="/transactions?reimbursable=yes">去处理</a>
    </div>
    <% } %>

    <div class="card dashboard-budgets" data-dashboard-column="plans">
      <div class="card-head">
        <h2>预算进度</h2>
        <a class="btn btn-sm btn-ghost" href="/budgets">管理 →</a>
      </div>
      <% if (!budgets.length) { %>
        <div class="empty" style="padding:20px 8px"><span class="big">🎯</span>还没有设置预算<div class="small mt8"><a href="/budgets">创建一个预算</a>，超支时会自动提醒你</div></div>
      <% } else { %>
        <% budgets.forEach(function(b){ %>
          <div class="mb12">
            <div class="row between small">
              <span class="bold"><%= b.icon || '🎯' %> <%= b.name %></span>
              <span class="<%= b.ratio >= 100 ? 'amount expense' : 'muted' %>"><%= helpers.fmtAmount(b.used) %> / <%= helpers.fmtAmount(b.amount_cents) %></span>
            </div>
            <div class="mt8"><%- charts.progressBar(b.used, b.amount_cents) %></div>
            <div class="tiny muted mt8">
              <% if (b.ratio >= 100) { %>
                已超支 <%= helpers.fmtAmount(b.used - b.amount_cents) %>
              <% } else { %>
                还剩 <%= helpers.fmtAmount(Number(b.amount_cents) - b.used) %>（<%= b.rangeLabel %>）
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <div class="card" data-dashboard-column="plans">
      <div class="card-head"><h2>订阅扣费</h2><a class="btn btn-sm btn-ghost" href="/subscriptions">管理 →</a></div>
      <% if (!subs || !subs.live.length) { %>
        <div class="empty" style="padding:20px 8px"><span class="big">🧾</span>还没有订阅
          <div class="small mt8">把 Netflix、云盘、服务器这类自动续费登记进来，<a href="/subscriptions">现在添加</a></div>
        </div>
      <% } else { %>
        <div class="row between small">
          <span class="muted">每月固定支出</span>
          <span class="amount expense bold"><%= helpers.fmtAmount(subs.monthlyTotal) %></span>
        </div>
        <div class="row between tiny muted mt8">
          <span>全年 <%= helpers.fmtAmount(subs.annualTotal) %></span>
          <span>生效 <%= subs.live.length %> 项 · 本月待扣 <%= subs.dueThisMonth %></span>
        </div>
        <div class="mt12">
          <% subs.live.slice(0, 3).forEach(function(it){ %>
            <div class="row between tiny" style="padding:4px 0;border-bottom:1px dashed var(--border)">
              <span><%= it.icon %> <%= it.name %> <span class="muted">· <%= it.cycleLabel %></span></span>
              <span class="<%= it.daysLeft <= 3 ? 'amount expense' : 'muted' %>"><%= it.next_charge_at.slice(5) %> <%= it.dueLabel %></span>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="card" data-dashboard-column="analysis">
      <div class="card-head"><h2>账户余额</h2><a class="btn btn-sm btn-ghost" href="/accounts">管理 →</a></div>
      <% if (!overview.accounts.length) { %>
        <div class="empty" style="padding:16px"><a href="/accounts">添加账户</a></div>
      <% } else { %>
        <% overview.accounts.slice(0, 6).forEach(function(a){ %>
          <div class="row between" style="padding:6px 0;border-bottom:1px dashed var(--border)">
            <span><%= a.icon %> <%= a.name %></span>
            <span class="amount <%= Number(a.balance_cents) < 0 ? 'expense' : '' %>"><%= helpers.money(a.balance_cents, a.currency) %></span>
          </div>
        <% }); %>
        <% if (overview.accounts.length > 6) { %>
          <div class="tiny muted mt8">还有 <%= overview.accounts.length - 6 %> 个账户…</div>
        <% } %>
      <% } %>
    </div>

    <% if (debts.length) { %>
    <div class="card" data-dashboard-column="analysis">
      <div class="card-head"><h2>借钱往来</h2><a class="btn btn-sm btn-ghost" href="/debts">查看 →</a></div>
      <% debts.forEach(function(d){ %>
        <div class="row between" style="padding:5px 0">
          <span><%= d.direction === 'receivable' ? '📥 别人欠我' : '📤 我欠别人' %>（<%= d.cnt %>）</span>
          <span class="amount <%= d.direction === 'receivable' ? 'income' : 'expense' %>"><%= helpers.money(d.total) %></span>
        </div>
      <% }); %>
    </div>
    <% } %>

    <% if (upcoming.length) { %>
    <div class="card" data-dashboard-column="plans">
      <div class="card-head"><h2>即将自动记账</h2><a class="btn btn-sm btn-ghost" href="/recurring">管理 →</a></div>
      <% upcoming.forEach(function(r){ %>
        <div class="row between small" style="padding:5px 0">
          <span><%= r.name %></span>
          <span class="muted"><%= r.next_run_at %> · <%= r.auto_post ? '自动' : '提醒' %></span>
        </div>
      <% }); %>
    </div>
    <% } %>
</div>
