<div class="notice info mb16">亲友之间的借出、借入请使用<a href="/debts">借钱台账</a>。这里管理银行贷款、车贷和信用卡；还本不算支出，实际利息与手续费才计入费用。</div>
<div class="finance-grid"><section class="card"><div class="card-head"><h2>贷款与车贷</h2><span class="chip"><%= loans.length %> 份合同</span></div>
<% if(!loans.length){ %><div class="empty">还没有贷款，登记现有负债或记录新放款即可开始。</div><% } %>
<% loans.forEach(l=>{ %><div class="finance-item"><div><b><%= l.name %></b><p class="small muted"><%= l.institution||'贷款' %> · <%= l.term_n %> 期</p></div><div class="right"><b class="amount"><%= helpers.money(Math.max(0,-l.balance_cents)) %></b><p class="tiny muted">剩余本金</p><a class="btn btn-sm mt8" href="/finance/loans/<%= l.id %>">管理贷款</a></div></div><% }); %>
<% if(archivedLoans.length){ %><details class="mt16"><summary>已归档合同</summary><% archivedLoans.forEach(l=>{ %><p><a href="/finance/loans/<%= l.id %>"><%= l.name %></a></p><% }); %></details><% } %></section>
<section class="card"><div class="card-head"><h2>信用卡</h2><a class="btn btn-sm" href="/accounts">管理账户</a></div><% if(!cards.length){ %><div class="empty">先在账户管理中新建信用卡账户。</div><% } %>
<% cards.forEach(c=>{ %><div class="finance-item"><div><b><%= c.name %></b><p class="small muted"><%= c.bill_day?'每月 '+c.bill_day+' 日出账':'待设置账期' %></p></div><div class="right"><b class="amount"><%= helpers.money(Math.max(0,-c.balance_cents)) %></b><% if(c.due_month_offset!==null){ %><p><a class="btn btn-sm" href="/finance/cards/<%= c.id %>">账单与还款</a></p><% } %></div></div>
<% if(c.due_month_offset===null&&canWrite(ledger.role)){ %><form class="finance-form mt12" method="post" action="/finance/cards/<%= c.id %>/configure"><input type="hidden" name="_csrf" value="<%= csrf %>"><%- include('partials/finance-card-config',{profile:{bill_day:20,due_day:10,due_month_offset:1,remind_enabled:1}}) %><button class="btn">启用账单管理</button></form><% } %><% }); %></section>
<% if(canWrite(ledger.role)){ %><section class="card finance-create"><div class="card-head"><h2>登记贷款</h2><span class="chip">期初负债不会生成消费</span></div><form method="post" action="/finance/loans" class="finance-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= operationKey %>">
<div class="finance-fields"><div class="field"><label>名称</label><input type="text" name="name" placeholder="例如：家用车贷" required maxlength="60"></div><div class="field"><label>贷款类型</label><select name="kind"><option value="loan">银行贷款</option><option value="car">车贷</option><option value="mortgage">房贷</option></select></div><div class="field"><label>银行或机构</label><input type="text" name="institution" maxlength="60"></div></div>
<div class="finance-fields"><div class="field"><label>原始本金（元）</label><input type="text" name="original_principal" inputmode="decimal" required></div><div class="field"><label>当前剩余本金（元）</label><input type="text" name="remaining_principal" inputmode="decimal" required></div></div>
<div class="field"><label>登记方式</label><select name="opening_mode"><option value="snapshot">登记当前负债，不移动资金</option><option value="disbursement">新放款，同时记录到账</option></select></div>
<div class="finance-fields"><div class="field"><label>接管已有贷款账户（可选）</label><select name="account_id"><option value="">新建贷款账户</option><% form.accounts.filter(a=>a.type==='loan').forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %> · <%= helpers.money(a.balance_cents) %></option><% }); %></select></div><div class="field"><label>新放款的收款账户</label><select name="funding_account_id"><option value="">登记当前负债无需选择</option><% form.accounts.filter(a=>!['credit','loan','payable','receivable'].includes(a.type)).forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %></option><% }); %></select></div></div>
<%- include('partials/finance-plan-fields',{params:{start_date:today,due_day:20,term_n:12,annual_rate:0,method:'equal_payment'}}) %><button class="btn btn-primary">创建贷款与还款计划</button></form></section><% } %></div>
