<section class="card mt16"><div class="card-head"><h2><%= payment.target_kind==='loan'?'贷款还款':'信用卡还款' %> #<%= payment.id %></h2><span class="chip"><%= payment.replaced_by?'已更正':payment.deleted_at?'已撤销':'已记录' %></span></div><p class="amount finance-total"><%= helpers.money(payment.amount_cents) %></p><p class="small muted"><%= payment.txn_date %> · 本金 <%= helpers.money(payment.principal_cents) %> · 利息 <%= helpers.money(payment.interest_cents) %> · 费用 <%= helpers.money(payment.fee_cents) %></p><% if(payment.replaced_by){ %><a class="btn btn-sm" href="/finance/payments/<%= payment.replaced_by %>">查看更正后的付款</a><% } %></section>
<div class="finance-detail"><div><section class="card"><h2>资金流水与来源</h2><p class="help">本金、利息和费用作为同一笔付款整体管理。已有正确转账仅关联；被替换的原记录保留供追溯。</p><% payment.transactions.forEach(t=>{ %><div class="finance-item"><div><b>#<%= t.id %> · <%= ({original:'原始来源',linked:'已有转账',principal:'本金转账',interest:'利息支出',fee:'手续费'})[t.role] %></b><p class="tiny muted"><%= t.txn_date %> · <%= t.note||'' %> · <%= t.deleted_at?'已停用':'有效' %></p></div><b class="amount"><%= helpers.money(t.amount_cents) %></b></div><% }); %></section><section class="card"><h2>对应账单与期次</h2><% if(payment.target_kind==='card'){ %><p class="small muted"><%= payment.allocation_mode==='auto'?'自动对应账单':'手动指定账单（例外）' %></p><% } %><% if(!payment.allocations.length){ %><div class="empty">预还款将在后续出账时自动抵扣。</div><% } %><% payment.allocations.forEach(a=>{ %><div class="finance-item"><% if(a.target_kind==='card'){ %><a class="btn btn-sm" href="/finance/statements/<%= a.target_id %>"><%= cardStatements.find(bill=>bill.id===a.target_id)?.closing_date||('#'+a.target_id) %> 账单</a><% }else{ %><span>贷款期次 #<%= a.target_id %></span><% } %><b><%= helpers.money(a.principal_cents+a.interest_cents+a.fee_cents) %></b></div><% }); %></section></div>
<aside><% if(canWrite(ledger.role)&&!payment.replaced_by){ %><section class="card"><h2>整体操作</h2><% if(payment.deleted_at){ %><form method="post" action="/finance/payments/<%= payment.id %>/restore"><input type="hidden" name="_csrf" value="<%= csrf %>"><p class="help">恢复前会重新检查来源占用、余额及账单可核销金额。</p><button class="btn btn-primary">恢复付款与核销</button></form><% }else{ %><form method="post" action="/finance/payments/<%= payment.id %>/reverse" data-confirm="撤销本次付款与核销？新建的资金流水会一并撤销；关联的已有转账会保留。"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="confirm" value="1"><p class="help">新建资金流水整体撤销；关联已有转账只撤销关联与核销，不删除原资金流水。</p><button class="btn btn-danger">整体撤销</button></form><details class="mt16"><summary>更正付款</summary><form class="finance-form mt16" method="post" action="/finance/payments/<%= payment.id %>/amend"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= operationKey %>"><div class="field"><label>付款账户</label><select name="account_id" required><% form.accounts.filter(a=>!['credit','loan','payable','receivable'].includes(a.type)).forEach(a=>{ %><option value="<%= a.id %>" <%= a.id===payment.account_id?'selected':'' %>><%= a.name %></option><% }); %></select></div><% if(payment.target_kind==='loan'){ %><div class="field"><label>本金（元）</label><input type="text" name="principal" inputmode="decimal" value="<%= (payment.principal_cents/100).toFixed(2) %>" required></div><div class="field"><label>利息（元）</label><input type="text" name="interest" inputmode="decimal" value="<%= (payment.interest_cents/100).toFixed(2) %>"></div><div class="field"><label>手续费（元）</label><input type="text" name="fee" inputmode="decimal" value="<%= (payment.fee_cents/100).toFixed(2) %>"></div><% }else{ %><div class="field"><label>实际还款（元）</label><input type="text" name="amount" inputmode="decimal" value="<%= (payment.amount_cents/100).toFixed(2) %>" required></div><% } %><div class="field"><label>日期</label><input type="date" name="date" value="<%= payment.txn_date %>" required></div><button class="btn">确认整体更正</button></form></details><% } %></section>
<% if(payment.target_kind==='card'&&!payment.deleted_at){ %><section class="card"><details><summary>高级：手动指定账单</summary><p class="help">日常还款无需使用此项。手动指定后本笔不再自动重排；只调整对应关系，资金不再移动；各账单输入本次付款分配的金额，留空为零。总分配不能超过付款。</p><form method="post" action="/finance/payments/<%= payment.id %>/allocate" class="finance-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><% cardStatements.forEach(s=>{ %><div class="field"><label><%= s.closing_date %> 账单 <%= s.dirty?'（待核对）':'' %></label><input type="hidden" name="bill_id" value="<%= s.id %>"><input type="text" name="bill_amount" inputmode="decimal" placeholder="0.00" value="<%= ((payment.allocations.find(a=>a.target_id===s.id)?.principal_cents||0)/100).toFixed(2) %>" <%= s.dirty?'readonly':'' %>></div><% }); %><button class="btn">保存分配</button></form><form method="post" action="/finance/payments/<%= payment.id %>/allocate" class="mt16"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm">恢复自动对应账单</button></form></details></section><% } %><% } %></aside></div>
