<form method="post" action="/finance/<%= kind==='loan'?'loans':'cards' %>/<%= targetId %>/payments" class="finance-form">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= operationKey %>">
<div class="field"><label>付款账户</label><select name="account_id" required><option value="">请选择资金账户</option><% form.accounts.filter(a=>!['credit','loan','payable','receivable'].includes(a.type)&&a.currency===(ledger.currency||baseCurrency)).forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %></option><% }); %></select></div>
<% if(kind==='loan'){ var nextPeriod=loan.installments.find(row=>row.remaining_principal+row.remaining_interest+row.remaining_fee>0); %><p class="small muted" data-loan-due>最近未还期 <%= nextPeriod?.due_date||'已结清' %></p><p class="amount finance-total" data-loan-total><%= helpers.money((nextPeriod?.remaining_principal||0)+(nextPeriod?.remaining_interest||0)+(nextPeriod?.remaining_fee||0)) %></p><details class="mb16"><summary>调整实际金额、期次及银行费用</summary><div class="finance-fields"><div class="field"><label>实际本金（<%= ledger.currency||baseCurrency %>）</label><input type="text" name="principal" inputmode="decimal" required value="<%= ((nextPeriod?.remaining_principal||0)/100).toFixed(2) %>"></div><div class="field"><label>实际利息（<%= ledger.currency||baseCurrency %>）</label><input type="text" name="interest" inputmode="decimal" value="<%= ((nextPeriod?.remaining_interest||0)/100).toFixed(2) %>"></div><div class="field"><label>实际手续费（<%= ledger.currency||baseCurrency %>）</label><input type="text" name="fee" inputmode="decimal" value="<%= ((nextPeriod?.remaining_fee||0)/100).toFixed(2) %>"></div></div>
<div class="field"><label>核销期次</label><select name="installment_id"><option value="" data-principal="<%= nextPeriod?.remaining_principal||0 %>" data-interest="<%= nextPeriod?.remaining_interest||0 %>" data-fee="<%= nextPeriod?.remaining_fee||0 %>" data-due="<%= nextPeriod?.due_date||'已结清' %>" data-total-label="<%= helpers.money((nextPeriod?.remaining_principal||0)+(nextPeriod?.remaining_interest||0)+(nextPeriod?.remaining_fee||0)) %>">最近未还期（自动）</option><% loan.installments.filter(i=>i.remaining_principal+i.remaining_interest+i.remaining_fee>0).forEach(i=>{ %><option value="<%= i.id %>" data-principal="<%= i.remaining_principal %>" data-interest="<%= i.remaining_interest %>" data-fee="<%= i.remaining_fee %>" data-due="<%= i.due_date %>" data-total-label="<%= helpers.money(i.remaining_principal+i.remaining_interest+i.remaining_fee) %>"><%= i.due_date %> · 本金 <%= helpers.money(i.remaining_principal) %> · 利息 <%= helpers.money(i.remaining_interest) %></option><% }); %></select></div><label class="check"><input type="checkbox" name="adjust_installment" value="1">按银行实扣校正所选期次的利息及费用</label></details>
<% }else{ %><div class="field"><label>实际还款金额（<%= ledger.currency||baseCurrency %>）</label><input type="text" name="amount" inputmode="decimal" value="<%= typeof suggestedAmount!=='undefined'&&suggestedAmount>0?(suggestedAmount/100).toFixed(2):'' %>" required></div><p class="help">默认按已出账的待还账单核销，超出部分保留为预还款，后续出账自动抵扣。不会重复计入支出。</p><% } %>
<div class="field"><label>实际付款日期</label><input type="date" name="date" value="<%= today %>" required></div>
<details class="mb16"><summary>这笔付款已在明细中记录</summary><p class="help">选择已有记录后先预览。正确转账只补关联；银行扣款会整体替换为本金与费用分项，保留原记录供追溯。</p>
<div class="field"><label>已有付款记录</label><select name="existing_transaction_id"><option value="">尚未记账，创建新付款</option><% sources.forEach(t=>{ %><option value="<%= t.id %>">#<%= t.id %> · <%= t.txn_date %> · <%= t.note||t.merchant||t.type %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div>
<div class="field"><label>目标账户的对应入账（可选）</label><select name="other_transaction_id"><option value="">没有第二条来源</option><% sources.filter(t=>['income','refund','repay_receive'].includes(t.type)).forEach(t=>{ %><option value="<%= t.id %>">#<%= t.id %> · <%= t.txn_date %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div>
<button class="btn" formaction="/finance/<%= kind==='loan'?'loans':'cards' %>/<%= targetId %>/sources/preview">预览关联与资金变化</button></details>
<button class="btn btn-primary" <%= kind==='loan'&&!nextPeriod?'disabled':'' %>>确认实际付款</button></form>
