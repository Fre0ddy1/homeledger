<form method="post" action="/finance/<%= kind==='loan'?'loans':'cards' %>/<%= targetId %>/payments" class="finance-form">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="operation_key" value="<%= operationKey %>">
<div class="field"><label>付款账户</label><select name="account_id" required><option value="">请选择资金账户</option><% form.accounts.filter(a=>!['credit','loan','payable','receivable'].includes(a.type)).forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %></option><% }); %></select></div>
<% if(kind==='loan'){ %><div class="finance-fields"><div class="field"><label>实际本金（元）</label><input type="text" name="principal" inputmode="decimal" required value="0"></div><div class="field"><label>实际利息（元）</label><input type="text" name="interest" inputmode="decimal" value="0"></div><div class="field"><label>实际手续费（元）</label><input type="text" name="fee" inputmode="decimal" value="0"></div></div>
<div class="field"><label>核销期次</label><select name="installment_id"><option value="">按到期顺序分配</option><% loan.installments.filter(i=>i.remaining_principal+i.remaining_interest+i.remaining_fee>0).forEach(i=>{ %><option value="<%= i.id %>"><%= i.due_date %> · 本金 <%= helpers.money(i.remaining_principal) %> · 利息 <%= helpers.money(i.remaining_interest) %></option><% }); %></select></div><label class="check"><input type="checkbox" name="adjust_installment" value="1">按银行实扣校正所选期次的利息及费用</label>
<% }else{ %><div class="field"><label>实际还款金额（元）</label><input type="text" name="amount" inputmode="decimal" required></div><p class="help">默认按已出账的待还账单核销，超出部分保留为未分配预还款。不会重复计入支出。</p><% } %>
<div class="field"><label>实际付款日期</label><input type="date" name="date" value="<%= today %>" required></div>
<details class="mb16"><summary>这笔付款已在明细中记录</summary><p class="help">选择已有记录后先预览。正确转账只补关联；银行扣款会整体替换为本金与费用分项，保留原记录供追溯。</p>
<div class="field"><label>已有付款记录</label><select name="existing_transaction_id"><option value="">尚未记账，创建新付款</option><% sources.forEach(t=>{ %><option value="<%= t.id %>">#<%= t.id %> · <%= t.txn_date %> · <%= t.note||t.merchant||t.type %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div>
<div class="field"><label>目标账户的对应入账（可选）</label><select name="other_transaction_id"><option value="">没有第二条来源</option><% sources.filter(t=>['income','refund','repay_receive'].includes(t.type)).forEach(t=>{ %><option value="<%= t.id %>">#<%= t.id %> · <%= t.txn_date %> · <%= helpers.money(t.amount_cents) %></option><% }); %></select></div>
<button class="btn" formaction="/finance/<%= kind==='loan'?'loans':'cards' %>/<%= targetId %>/sources/preview">预览关联与资金变化</button></details>
<button class="btn btn-primary">确认实际付款</button></form>
