<%
  // 交易列表渲染（按日期分组）
  // 需要：groups（txn.groupByDate 的结果）
  var showCheckbox = typeof bulk !== 'undefined' && bulk;
%>
<% if (!groups || !groups.length) { %>
  <div class="empty">
    <span class="big">🗒️</span>
    还没有记录
    <div class="small mt8">点右上角「＋ 记一笔」开始，或上传账单截图让 AI 帮你记</div>
  </div>
<% } else { %>
  <% groups.forEach(function(g){ %>
    <div class="txn-day">
      <div class="txn-day-head">
        <% if (showCheckbox) { %><input type="checkbox" class="bulk-all-day" style="margin-right:2px" title="全选本日"><% } %>
        <span class="bold" style="color:var(--text-2)"><%= g.basis==='created'?'录入于 ':'' %><%= helpers.relDate(g.date) %></span>
        <span class="muted tiny"><%= helpers.weekdayOf(g.date) %></span>
        <span class="day-sum">
          <% if (g.income) { %><span class="amount income">+<%= helpers.fmtAmount(g.income) %></span><% } %>
          <% if (g.expense) { %><span class="amount expense">-<%= helpers.fmtAmount(g.expense) %></span><% } %>
        </span>
      </div>
      <% g.items.forEach(function(t){
        const unifiedAdvance = typeof billList !== 'undefined' && billList && t.advance?.primary_transaction_id === t.id;
        const editHref = '/transactions/'+t.id+'/edit?back='+encodeURIComponent(typeof currentUrl!=='undefined'?currentUrl:'/transactions');
        const writable = ledger && canWrite(ledger.role);
      %>
        <div class="txn <%= t.status === 'pending' ? 'pending' : '' %>" data-txn-id="<%= t.id %>" <%= unifiedAdvance?'data-advance-main':'' %> title="点击查看详情" tabindex="0" role="group" aria-label="交易记录，按回车查看详情">
          <% if (showCheckbox) { %>
            <input type="checkbox" class="bulk-item" name="ids" value="<%= t.id %>" form="bulk-form">
          <% } %>
          <div class="txn-ico" style="background:<%= t.category_color ? t.category_color + '18' : 'var(--card-2)' %>"><%= t.category_icon || t.type_icon %></div>
          <div class="txn-main">
            <div class="txn-title">
              <% if (t.category_id && t.has_category) { %>
                <%# 点分类名即按该分类筛选（transfers 无分类语义，保持纯文本） %>
                <a class="txn-cat" href="/transactions?category_id=<%= t.category_id %>" title="查看该分类的全部记录"><%= t.category_name || t.type_label %></a>
              <% } else { %>
                <span><%= !t.has_category ? t.type_label : (t.category_name || t.type_label) %></span>
              <% } %>
              <% if (t.category_parent && t.has_category) { %><span class="tiny muted"><%= t.category_parent %></span><% } %>
              <%# 商家与备注同时直接可见（此前二选一显示） %>
              <% if (t.merchant) { %><span class="txn-merchant"><%= t.merchant %></span><% } %>
              <% if (t.note) { %><span class="note"><%= t.note %></span><% } %>
            </div>
            <div class="txn-sub">
              <% if(g.basis==='created'){ %><span>交易日期 <time datetime="<%= t.txn_date %>"><%= t.txn_date %></time></span><span>·</span><% } %>
              <% if(t.txn_time_label){ %><time datetime="<%= t.txn_date %>T<%= t.txn_time %>"><%= t.txn_time_label %></time><span>·</span><% } %>
              <% if (t.type === 'transfer' || t.type === 'invest_buy' || t.type === 'invest_sell') { %>
                <span><%= t.account_name || '—' %><% if(t.account_type_label){ %> · <%= t.account_type_label %><% } %></span><span>→</span><span><%= t.to_account_name || '—' %><% if(t.to_account_type_label){ %> · <%= t.to_account_type_label %><% } %></span>
              <% } else { %>
                <span><%= t.account_name || '未指定账户' %><% if(t.account_type_label){ %> · <%= t.account_type_label %><% } %></span>
              <% } %>
              <% if (t.member_name) { %><span>·</span><span><%= t.member_name %></span><% } %>
              <% if (t.tag_names) { %>
                <% t.tag_names.split(' ').forEach(function(tag){ %><span class="tag-pill"><%= tag %></span><% }); %>
              <% } %>
              <% if (t.is_reimbursable) { %>
                <span class="chip <%= t.reimbursed_at ? 'income' : 'warn' %>"><%= t.reimbursed_at ? '已报销' : '待报销' %></span>
              <% } %>
              <% if (t.refunded_cents > 0) { %>
                <span class="chip <%= t.refunded_cents >= t.amount_cents ? 'income' : 'warn' %>"><%= t.refunded_cents >= t.amount_cents ? '已退款' : '部分退款 ' + helpers.fmtAmount(t.refunded_cents) %></span>
              <% } %>
              <% if(t.advance_collection&&t.advance_collection.excess_cents){ %><span>回本 <%= helpers.fmtAmount(t.advance_collection.principal_cents) %> · 凑整收入 <%= helpers.fmtAmount(t.advance_collection.excess_cents) %></span><% } %>
              <% if(t.advance){
                const personalAmount = helpers.fmtAmount(t.advance.personal_cents);
                const advanceAmount = helpers.fmtAmount(t.advance.advance_cents);
              %>
                <% if(unifiedAdvance){ %>
                  <span class="chip advance-split">自用&nbsp;<%= personalAmount %> · 代垫&nbsp;<%= advanceAmount %></span>
                  <noscript>
                    <% if(writable){ %><a class="btn btn-sm btn-ghost advance-bill-native-edit" href="<%= editHref %>">编辑</a>
                    <% }else{ %><a class="btn btn-sm btn-ghost" href="/advances/<%= t.advance.id %>">查看代垫详情</a><% } %>
                  </noscript>
                <% }else{ %><a class="btn btn-sm" href="/advances/<%= t.advance.id %>">自用 <%= personalAmount %> · 代垫 <%= advanceAmount %></a><% } %>
              <% } %>
              <% if(t.advance){ %><span class="chip <%= t.advance.remaining_cents===0?'income':'warn' %>"><%= t.advance.remaining_cents===0?'代垫已收齐':(t.advance.received_cents?'部分收回 · ':'')+'待收 '+helpers.fmtAmount(t.advance.remaining_cents) %></span><% } %>
              <% if (t.status === 'pending') { %><span class="chip">待确认</span><% } %>
              <% if (t.attachment_count) { %><span class="chip" title="已关联账单截图">📎 <%= t.attachment_count %></span><% } %>
              <% if (t.source === 'ai_screenshot' || t.source === 'ai_text') { %><span class="chip primary">AI</span><% } %>
              <% if (t.source === 'import') { %><span class="chip">导入</span><% } %>
              <% if (t.source === 'recurring') { %><span class="chip">周期</span><% } %>
              <% if (t.source === 'subscription') { %><span class="chip primary">订阅</span><% } %>
            </div>
          </div>
          <%# 金额符号与配色统一用后端口径（decorate 提供 is_income/is_expense/flow）：
              入账类（income/refund/reimburse/interest/repay_receive/borrow）→ + 绿色；
              流出类（expense/fee/lend/repay_pay）→ - 红色；
              搬移类（transfer/invest_*/adjust）→ 无符号中性，adjust 自带正负号 %>
          <% var displayAmount=t.advance&&t.delta===undefined&&!t.component_view&&t.id===t.advance.primary_transaction_id?t.advance.total_cents:(t.advance_collection?.role==='principal'&&t.delta===undefined&&!t.component_view?t.advance_collection.total_cents:t.amount_cents); %>
          <div class="txn-amt amount <%= t.type === 'adjust' ? 'neutral' : (t.is_income ? 'income' : (t.is_expense ? 'expense' : 'neutral')) %>">
            <% if (t.type === 'adjust') { %>
              <%= helpers.fmtAmount(t.amount_cents) %>
            <% } else if (t.is_income) { %>
              +<%= helpers.fmtAmount(displayAmount) %>
            <% } else if (t.is_expense) { %>
              -<%= helpers.fmtAmount(displayAmount) %>
            <% } else { %>
              <%= helpers.fmtAmount(displayAmount) %>
            <% } %>
            <% if (t.currency !== 'CNY') { %><div class="tiny muted"><%= t.currency %></div><% } %>
          </div>
          <% if (writable) { %><div class="txn-act">
            <% if(t.advance_collection||t.advance&&t.id!==t.advance.primary_transaction_id){ %><a class="btn btn-sm" href="/advances/<%= t.advance_collection?.advance_id||t.advance.id %>">管理代垫</a><% }else{ %>
            <a class="btn btn-sm btn-ghost" href="<%= editHref %>" title="编辑" aria-label="编辑"><svg class="icon sm"><use href="#i-pencil"></use></svg></a>
            <button class="btn btn-sm btn-ghost" type="button" data-del-txn="<%= t.id %>" <%= t.advance?'data-del-advance':'' %> title="删除" aria-label="删除"><svg class="icon sm"><use href="#i-trash-2"></use></svg></button>
            <% } %>
          </div><% } %>
        </div>
      <% }); %>
    </div>
  <% }); %>
<% } %>
