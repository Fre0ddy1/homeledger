   ['🔥','燃气'],['🧹','保洁'],['🧺','洗衣'],['🛋️','家具'],['🛏️','床品'],['🔑','房租'],['🏢','物业'],['🏡','房屋'],
   ['👟','鞋履'],['💄','美妆'],['💇','理发'],['🧸','玩具'],['🍼','奶粉'],['🐶','狗狗'],['🐱','猫咪'],['🦷','牙科'],['🏥','医院'],['🩺','体检'],
   ['✏️','文具'],['🎓','学费'],['🎨','绘画'],['🎵','音乐'],['🏊','游泳'],['⚽','足球'],['🏕️','露营'],['🏖️','度假'],['🏨','住宿'],['🎟️','门票'],
   ['💵','工资'],['🧧','红包'],['↩️','退款'],['🎯','目标'],['🧮','税费'],['🛡️','保险'],['🤝','人情'],['❤️','公益'],['🧑‍💻','兼职'],['📦','快递'],['📮','邮寄'],['📅','定期']
 ];
 const currentIcon=iconValue||'🏷️';
%>
<div class="field category-icon-field category-icon-picker" data-fallback-icon="<%= currentIcon %>">
  <label for="<%= fieldId %>">图标</label>
  <div class="category-icon-input"><span class="category-icon-preview" aria-hidden="true"><%= currentIcon %></span><input id="<%= fieldId %>" name="icon" type="text" value="<%= currentIcon %>" maxlength="8" list="<%= fieldId %>-options" aria-describedby="<%= fieldId %>-hint" placeholder="输入或粘贴表情" autocomplete="off"></div>
  <datalist id="<%= fieldId %>-options"><% iconChoices.forEach(([icon,label])=>{ %><option value="<%= icon %>" label="<%= label %>"></option><% }); %></datalist>
  <p class="help" id="<%= fieldId %>-hint">可输入或粘贴自定义表情</p>
  <div class="category-icon-choices hidden">
    <div class="category-icon-grid" role="group" aria-label="常用分类图标"><% iconChoices.slice(0,24).forEach(([icon,label])=>{ %><button type="button" class="category-icon-choice" data-icon-choice="<%= icon %>" aria-label="选择<%= label %>图标" title="<%= label %>" aria-pressed="<%= currentIcon===icon %>"><%= icon %></button><% }); %></div>
    <details class="category-icon-more"><summary>更多图标</summary><div class="category-icon-grid" role="group" aria-label="更多分类图标"><% iconChoices.slice(24).forEach(([icon,label])=>{ %><button type="button" class="category-icon-choice" data-icon-choice="<%= icon %>" aria-label="选择<%= label %>图标" title="<%= label %>" aria-pressed="<%= currentIcon===icon %>"><%= icon %></button><% }); %></div></details>
  </div>
</div>
