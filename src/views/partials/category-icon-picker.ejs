<%
 const iconChoices=[['🍽️','餐饮'],['☕','咖啡'],['🚗','交通'],['🛍️','购物'],['🏠','居家'],['💊','医疗'],['📚','教育'],['🎮','娱乐'],['🎁','礼物'],['💰','收入'],['💳','金融'],['🏷️','其他'],['🥣','早餐'],['🍜','用餐'],['🧋','饮品'],['🍎','水果'],['🚇','地铁'],['✈️','旅行'],['⛽','加油'],['👕','服饰'],['🧴','日用'],['📱','数码'],['🌐','网络'],['💡','电费'],['💧','水费'],['🛠️','维修'],['🐾','宠物'],['👶','育儿'],['🏋️','运动'],['🎬','影音'],['🏦','银行'],['📈','投资'],['🧾','账单'],['💼','工作'],['🎉','庆祝'],['🪙','储蓄']];
 const currentIcon=iconValue||'🏷️';
%>
<div class="field category-icon-field category-icon-picker" data-fallback-icon="<%= currentIcon %>">
  <label for="<%= fieldId %>">图标</label>
  <div class="category-icon-input"><span class="category-icon-preview" aria-hidden="true"><%= currentIcon %></span><input id="<%= fieldId %>" name="icon" type="text" value="<%= currentIcon %>" maxlength="8" list="<%= fieldId %>-options" aria-describedby="<%= fieldId %>-hint" placeholder="输入或粘贴表情" autocomplete="off"></div>
  <datalist id="<%= fieldId %>-options"><% iconChoices.forEach(([icon,label])=>{ %><option value="<%= icon %>" label="<%= label %>"></option><% }); %></datalist>
  <p class="help" id="<%= fieldId %>-hint">可输入或粘贴自定义表情</p>
  <div class="category-icon-choices hidden">
    <div class="category-icon-grid" role="group" aria-label="常用分类图标"><% iconChoices.slice(0,12).forEach(([icon,label])=>{ %><button type="button" class="category-icon-choice" data-icon-choice="<%= icon %>" aria-label="选择<%= label %>图标" title="<%= label %>" aria-pressed="<%= currentIcon===icon %>"><%= icon %></button><% }); %></div>
    <details class="category-icon-more"><summary>更多图标</summary><div class="category-icon-grid" role="group" aria-label="更多分类图标"><% iconChoices.slice(12).forEach(([icon,label])=>{ %><button type="button" class="category-icon-choice" data-icon-choice="<%= icon %>" aria-label="选择<%= label %>图标" title="<%= label %>" aria-pressed="<%= currentIcon===icon %>"><%= icon %></button><% }); %></div></details>
  </div>
</div>
