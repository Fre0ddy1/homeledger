<%
 const currentIcon=iconValue||'🏷️';
 const iconCatalog=categoryIconCatalog;
%>
<div class="field category-icon-field category-icon-picker" data-fallback-icon="<%= currentIcon %>">
  <label for="<%= fieldId %>">图标</label>
  <div class="category-icon-input"><span class="category-icon-preview" aria-hidden="true"><%= currentIcon %></span><input id="<%= fieldId %>" name="icon" type="text" value="<%= currentIcon %>" maxlength="8" list="<%= fieldId %>-options" aria-describedby="<%= fieldId %>-hint" placeholder="输入或粘贴表情" autocomplete="off"></div>
  <datalist id="<%= fieldId %>-options"><% iconCatalog.choices.forEach(choice=>{ %><option value="<%= choice.icon %>" label="<%= choice.label %>"></option><% }); %></datalist>
  <p class="help" id="<%= fieldId %>-hint">可输入或粘贴自定义表情</p>
  <div class="category-icon-choices hidden">
    <div class="category-icon-grid" role="group" aria-label="常用分类图标" data-icon-common-grid><% iconCatalog.common.forEach(choice=>{ %><button type="button" class="category-icon-choice" data-icon-choice="<%= choice.icon %>" aria-label="选择<%= choice.label %>图标" title="<%= choice.label %>" aria-pressed="<%= currentIcon===choice.icon %>"><%= choice.icon %></button><% }); %></div>
    <details class="category-icon-more">
      <summary>更多图标 · <%= iconCatalog.choices.length %> 个</summary>
      <div class="category-icon-tools">
        <div><label for="<%= fieldId %>-search">搜索图标</label><input id="<%= fieldId %>-search" type="search" data-icon-search placeholder="例如：猫砂、牙科、停车" autocomplete="off"></div>
        <div><label for="<%= fieldId %>-group">场景<span class="muted tiny">（搜索时查全部）</span></label><select id="<%= fieldId %>-group" data-icon-group-filter><option value="">全部场景</option><% iconCatalog.groups.forEach((group,index)=>{ %><option value="<%= group.key %>" <%= index===0?'selected':'' %>><%= group.label %></option><% }); %></select></div>
      </div>
      <p class="help category-icon-status" data-icon-status aria-live="polite"></p>
      <% iconCatalog.groups.forEach(group=>{ %><section class="category-icon-group" data-icon-group="<%= group.key %>" aria-label="<%= group.label %>图标">
        <h4 class="category-icon-group-title"><%= group.label %></h4>
        <div class="category-icon-grid" role="group" aria-label="<%= group.label %>候选"><% group.choices.forEach(choice=>{ %><button type="button" class="category-icon-choice" data-icon-choice="<%= choice.icon %>" data-icon-search-text="<%= choice.search %>" data-icon-common="<%= choice.common %>" aria-label="选择<%= choice.label %>图标" title="<%= choice.label %>" aria-pressed="<%= currentIcon===choice.icon %>" <%= choice.common?'hidden':'' %>><%= choice.icon %></button><% }); %></div>
      </section><% }); %>
      <p class="help category-icon-empty" data-icon-empty hidden>没有匹配图标，可在上方输入或粘贴自定义表情。</p>
    </details>
  </div>
</div>
